{
  "version": 2,
  "paper": {
    "bleed_in": 0.125,
    "min_dpi": 96,
    "max_dpi": 1200,
    "sizes": {
      "5x7": [5.0, 7.0],
      "4x6": [4.0, 6.0],
      "5x5": [5.0, 5.0],
      "a6": [4.13, 5.83],
      "a2": [4.25, 5.5]
    }
  },
  "composition": {
    "margin": {"recommended_min": 0.045, "recommended_max": 0.12},
    "slots": {
      "max": 12,
      "min_side": 0.06,
      "min_area": 0.004,
      "treatments": ["plain", "border", "shadow", "tilt", "rounded"]
    },
    "zones": {
      "max": 10,
      "min_area": 0.006,
      "min_width": 0.16,
      "alignments": ["left", "center", "right"],
      "valigns": ["top", "center", "bottom"]
    },
    "photos": {"min_coverage": 0.20, "max_coverage": 0.84},
    "ornaments": {"max": 4, "kinds": ["holly", "snow", "stars", "confetti", "none"]},
    "lines": {"max": 8, "tokens": ["ink", "soft", "accent", "panel", "bg"], "max_weight": 3},
    "faces": {"min_crop_keep": 0.65, "min_width_in": 0.16},
    "type_safety": {"min_pt": 7.0, "min_message_pt": 7.5}
  },
  "type": {
    "roles": {
      "greeting": {"scale": 0.082, "min_scale": 0.038, "max_lines": 3, "tracking": "direction", "weight": "heading", "spacing": 1.12, "uppercase": "direction", "font": "auto"},
      "family": {"scale": 0.050, "min_scale": 0.024, "max_lines": 2, "tracking": "direction", "weight": "heading", "spacing": 1.12, "uppercase": "direction", "font": "auto"},
      "message": {"scale": 0.027, "min_scale": 0.016, "max_lines": 14, "tracking": 0, "weight": "body", "spacing": 1.42, "uppercase": false, "font": "body"},
      "signature": {"scale": 0.031, "min_scale": 0.018, "max_lines": 2, "tracking": 0, "weight": "body", "spacing": 1.35, "uppercase": false, "font": "auto"},
      "year": {"scale": 0.021, "min_scale": 0.014, "max_lines": 1, "tracking": 0.10, "weight": "body", "spacing": 1.2, "uppercase": true, "font": "body"},
      "caption": {"scale": 0.017, "min_scale": 0.012, "max_lines": 3, "tracking": 0, "weight": "body", "spacing": 1.3, "uppercase": false, "font": "body"},
      "monogram": {"scale": 0.150, "min_scale": 0.08, "max_lines": 1, "tracking": 0.04, "weight": "heading", "spacing": 1.0, "uppercase": false, "font": "auto"},
      "title": {"scale": 0.110, "min_scale": 0.05, "max_lines": 3, "tracking": "direction", "weight": "heading", "spacing": 1.10, "uppercase": "direction", "font": "heading"},
      "subtitle": {"scale": 0.034, "min_scale": 0.018, "max_lines": 2, "tracking": 0, "weight": "body", "spacing": 1.3, "uppercase": false, "font": "auto"},
      "eyebrow": {"scale": 0.019, "min_scale": 0.012, "max_lines": 1, "tracking": 0.16, "weight": "body", "spacing": 1.2, "uppercase": true, "font": "body"},
      "statement": {"scale": 0.064, "min_scale": 0.03, "max_lines": 4, "tracking": 0, "weight": "heading", "spacing": 1.10, "uppercase": false, "font": "heading"},
      "numeral": {"scale": 0.095, "min_scale": 0.04, "max_lines": 1, "tracking": 0, "weight": "heading", "spacing": 1.0, "uppercase": false, "font": "heading"},
      "folio": {"scale": 0.017, "min_scale": 0.012, "max_lines": 1, "tracking": 0.08, "weight": "body", "spacing": 1.2, "uppercase": true, "font": "body"}
    }
  },
  "palettes": {
    "evergreen": {"label": "Evergreen", "bg": "#F6F1E4", "ink": "#1E3A2B", "soft": "#4C6152", "accent": "#9C1B23", "panel": "#1E3A2B", "on_panel": "#F6F1E4"},
    "cranberry": {"label": "Cranberry", "bg": "#FBF4EF", "ink": "#4A1D24", "soft": "#7C5257", "accent": "#A62B33", "panel": "#4A1D24", "on_panel": "#FBF4EF"},
    "midnight": {"label": "Midnight", "bg": "#0E1B2A", "ink": "#EAF0F6", "soft": "#AFC0D0", "accent": "#C9A227", "panel": "#16273A", "on_panel": "#EAF0F6"},
    "nordic": {"label": "Nordic", "bg": "#EEF1F0", "ink": "#25322F", "soft": "#5C6D68", "accent": "#7E9B91", "panel": "#25322F", "on_panel": "#EEF1F0"},
    "brass": {"label": "Brass", "bg": "#F7F3EC", "ink": "#2B2A26", "soft": "#6B665C", "accent": "#B08D4F", "panel": "#2B2A26", "on_panel": "#F7F3EC"},
    "peppermint": {"label": "Peppermint", "bg": "#FAF7F2", "ink": "#22313A", "soft": "#5B6E78", "accent": "#C0392B", "panel": "#22313A", "on_panel": "#FAF7F2"}
  },
  "directions": {
    "classic": {
      "label": "Classic Christmas",
      "blurb": "Cream stock, deep green and holly; the card most families picture.",
      "guidance": "Centred, generous but not airy. A double rule and holly in two corners. Serif heading, sans body, script only for a name if you use it. Photographs framed with a keyline.",
      "palette": "evergreen", "heading": "playfair", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "heading", "caps": false, "weight": 700,
      "tracking": 0.02, "align": "center", "margin": 0.07, "decoration": "holly",
      "density": 0.5, "border": "double", "photo_frame": "border", "radius": 0.0, "texture": true
    },
    "modern": {
      "label": "Modern Minimalist",
      "blurb": "Lots of air, one small rule, tiny stars and left-aligned type.",
      "guidance": "Left-aligned, wide margins, one hairline. Keep photographs large but never touching the text column. Stars are a few marks, not a snowstorm.",
      "palette": "nordic", "heading": "montserrat", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "body", "caps": true, "weight": 500,
      "tracking": 0.18, "align": "left", "margin": 0.085, "decoration": "stars",
      "density": 0.18, "border": "rule", "photo_frame": "plain", "radius": 0.012, "texture": false
    },
    "traditional": {
      "label": "Traditional Holiday",
      "blurb": "Deep cranberry, capitals, snow falling behind a framed grid.",
      "guidance": "Capitals and a heavy frame. Snow behind the photographs, never over a face. A script signature is allowed; the greeting is roman.",
      "palette": "cranberry", "heading": "cormorant", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "script", "caps": true, "weight": 700,
      "tracking": 0.12, "align": "center", "margin": 0.065, "decoration": "snow",
      "density": 0.7, "border": "frame", "photo_frame": "border", "radius": 0.0, "texture": true
    },
    "editorial": {
      "label": "Luxury Editorial",
      "blurb": "A magazine spread: wide margins, brass rules, photographs as plates.",
      "guidance": "Asymmetry is welcome: a text column beside a photographic plate. Wide margins, no decoration, hairlines as dividers. Left-aligned copy reads best.",
      "palette": "brass", "heading": "playfair", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "body", "caps": true, "weight": 500,
      "tracking": 0.14, "align": "left", "margin": 0.085, "decoration": "none",
      "density": 0.0, "border": "rule", "photo_frame": "plain", "radius": 0.0, "texture": false
    },
    "nordic": {
      "label": "Scandinavian",
      "blurb": "Pale grey-green, small photographs, a scatter of quiet stars.",
      "guidance": "Quiet and small. Photographs can be modest; leave more paper than picture. Sparse stars, no border, a soft grey-green palette.",
      "palette": "nordic", "heading": "montserrat", "body": "cormorant", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "body", "caps": true, "weight": 500,
      "tracking": 0.22, "align": "center", "margin": 0.075, "decoration": "stars",
      "density": 0.4, "border": "none", "photo_frame": "plain", "radius": 0.008, "texture": false
    },
    "vintage": {
      "label": "Vintage Christmas",
      "blurb": "Warm paper, a postcard border, tilted frames and holly sprigs.",
      "guidance": "Postcard framing, a small tilt on one photograph only. Warm paper, holly in a corner, script for the signature. Never tilt a photograph that holds faces near an edge.",
      "palette": "cranberry", "heading": "cormorant", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "script", "caps": false, "weight": 600,
      "tracking": 0.06, "align": "center", "margin": 0.07, "decoration": "holly",
      "density": 0.45, "border": "postcard", "photo_frame": "tilt", "radius": 0.004, "texture": true
    },
    "joyful": {
      "label": "Playful Festive",
      "blurb": "Bright red, script lettering, confetti and shadowed snapshots.",
      "guidance": "Script greeting, confetti, photographs with soft shadows. Keep the confetti out of the words and off faces. Two or three photographs is plenty.",
      "palette": "peppermint", "heading": "playfair", "body": "lato", "script": "greatvibes",
      "greeting_font": "script", "name_font": "body", "caps": false, "weight": 700,
      "tracking": 0.0, "align": "center", "margin": 0.07, "decoration": "confetti",
      "density": 0.8, "border": "none", "photo_frame": "shadow", "radius": 0.02, "texture": false
    },
    "gallery": {
      "label": "Photo-First",
      "blurb": "Nearly all photographs, a thin rule and a small line of type.",
      "guidance": "The photographs are the card. One thin rule, one small line of type, no decoration. Crops must keep faces whole; use the face report.",
      "palette": "evergreen", "heading": "lato", "body": "lato", "script": "greatvibes",
      "greeting_font": "heading", "name_font": "heading", "caps": true, "weight": 700,
      "tracking": 0.24, "align": "center", "margin": 0.05, "decoration": "none",
      "density": 0.0, "border": "rule", "photo_frame": "shadow", "radius": 0.006, "texture": false
    }
  }
}
