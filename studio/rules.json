{
  "version": 4,
  "paper": {
    "bleed_in": 0.125,
    "min_dpi": 96,
    "max_dpi": 1200,
    "sizes": {
      "5x7": [5.0, 7.0],
      "4x6": [4.0, 6.0],
      "5x5": [5.0, 5.0],
      "a6": [4.13, 5.83],
      "a2": [4.25, 5.5]
    }
  },
  "palette": {
    "keys": ["bg", "ink", "soft", "accent", "panel", "on_panel"],
    "min_text_contrast": 4.5,
    "min_decor_contrast": 1.3
  },
  "type": {
    "default_font": "lato",
    "sizes": {"min": 0.012, "max": 0.50},
    "weights": {"min": 100, "max": 900},
    "tracking": {"min": -0.06, "max": 0.45},
    "leading": {"min": 0.85, "max": 2.4},
    "parts": {
      "greeting": "the main wish, e.g. Merry Christmas",
      "family": "the family name, or who the card is from",
      "message": "the letter: a few sentences of news",
      "signature": "the sign-off, e.g. with love, Anna and Tom",
      "year": "the year, usually set small",
      "caption": "one line naming a photograph or a date",
      "monogram": "initials, set large",
      "title": "a presentation slide's title",
      "subtitle": "a slide's second line",
      "eyebrow": "a small label above a title",
      "statement": "one sentence set large",
      "numeral": "a big number: a date, an age, a count",
      "folio": "a page number or a small running foot"
    }
  },
  "composition": {
    "margin": {"safe": 0.045, "border": 0.055},
    "slots": {
      "max": 12,
      "min_side": 0.06,
      "min_area": 0.004,
      "radius": 0.03,
      "treatments": ["plain", "border", "shadow", "tilt", "rounded"],
      "clips": ["rect", "rounded", "arch", "circle", "oval"],
      "max_rotate": 12
    },
    "zones": {
      "max": 14,
      "min_area": 0.006,
      "min_width": 0.16,
      "alignments": ["left", "center", "right"],
      "valigns": ["top", "center", "bottom"],
      "max_rotate": 90
    },
    "shapes": {
      "max": 16,
      "kinds": ["rect", "band", "circle", "ellipse", "arch", "panel", "rounded", "line"]
    },
    "layers": { "min": -5, "max": 5 },
    "chrome": {
      "borders": ["none", "rule", "double", "frame", "postcard"]
    },
    "backgrounds": { "scrim_max": 0.95 },
    "diversity": { "warn_plain": true, "step": 0.05 },
    "photos": {"min_coverage": 0.20, "max_coverage": 0.84},
    "ornaments": {"max": 4, "kinds": ["holly", "snow", "stars", "confetti", "none"]},
    "lines": {"max": 8, "tokens": ["ink", "soft", "accent", "panel", "bg"], "max_weight": 3},
    "faces": {"min_crop_keep": 0.65, "min_width_in": 0.16},
    "type_safety": {"min_pt": 7.0, "min_message_pt": 7.5}
  }
}
